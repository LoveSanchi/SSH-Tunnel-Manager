[Unit]
Description=Keep SSH port-forward tunnels alive (tunnel-keeper)
Documentation=file:///usr/share/doc/tunnel-keeper/README.md
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/lib/tunnel-keeper/tunnel-keeperd
ExecReload=/bin/kill -HUP $MAINPID
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
# 78 = bad config or socket already taken: restarting would not help.
RestartPreventExitStatus=78
# Our ssh children live in this unit's cgroup: stopping the service closes them too.
KillMode=control-group

[Install]
WantedBy=default.target
